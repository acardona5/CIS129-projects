def is_palindrome(s):

    filtered_chars = [char for char in s if char.isalnum()]
    
    # lowercase to ignore case sensitivity
    clean_string = ''.join(filtered_chars).lower()

    stack = []
    
    # push characters to stack
    for char in clean_string:
        stack.append(char)
    
    #check if the string is the same backwards
    for char in clean_string:
        if char != stack.pop():  # compare with the popped character?
            return False
        
    
    return True


